{
  "description": "Test cases for CT-FIRE Python implementation vs MATLAB ctFIRE reference",
  "test_cases": [
    {
      "name": "real1_default",
      "image": "real1.tif",
      "description": "real1 image with default CT-FIRE parameters (thresh_im2=5)",
      "ctfire_params": {
        "coefficient_percentile": 0.2,
        "num_scales": 3,
        "LL1": 30,
        "value": {
          "sigma_im": 0,
          "sigma_d": 0.3,
          "dtype": "cityblock",
          "thresh_im": [],
          "thresh_im2": 5,
          "thresh_Dxlink": 1.5,
          "s_xlinkbox": 8,
          "thresh_LMP": 0.2,
          "thresh_LMPdist": 2,
          "thresh_ext": 0.342,
          "lam_dirdecay": 0.5,
          "s_minstep": 2,
          "s_maxstep": 6,
          "thresh_dang_aextend": 0.9848,
          "thresh_dang_L": 15,
          "thresh_short_L": 15,
          "s_fiberdir": 4,
          "thresh_linkd": 15,
          "thresh_linka": -0.866,
          "thresh_flen": 15,
          "thresh_numv": 3,
          "scale": [1.0, 1.0, 1.0],
          "s_boundthick": 10,
          "blist": 1,
          "s_maxspace": 5,
          "lambda": 0.01,
          "ang_interval": 3
        }
      },
      "expected_outputs": {
        "min_fiber_count": 50,
        "max_fiber_count": 1000,
        "min_avg_length": 10,
        "max_avg_length": 120
      },
      "matlab_reference_mat": "test_ct_fire_real1_default.mat"
    },
    {
      "name": "real2_th30",
      "image": "real2.tif",
      "description": "real2 image with thresh_im2=30 for cleaner background masking",
      "ctfire_params": {
        "coefficient_percentile": 0.2,
        "num_scales": 3,
        "LL1": 30,
        "value": {
          "sigma_im": 0,
          "sigma_d": 0.3,
          "dtype": "cityblock",
          "thresh_im": [],
          "thresh_im2": 30,
          "thresh_Dxlink": 1.5,
          "s_xlinkbox": 8,
          "thresh_LMP": 0.2,
          "thresh_LMPdist": 2,
          "thresh_ext": 0.342,
          "lam_dirdecay": 0.5,
          "s_minstep": 2,
          "s_maxstep": 6,
          "thresh_dang_aextend": 0.9848,
          "thresh_dang_L": 15,
          "thresh_short_L": 15,
          "s_fiberdir": 4,
          "thresh_linkd": 15,
          "thresh_linka": -0.866,
          "thresh_flen": 15,
          "thresh_numv": 3,
          "scale": [1.0, 1.0, 1.0],
          "s_boundthick": 10,
          "blist": 1,
          "s_maxspace": 5,
          "lambda": 0.01,
          "ang_interval": 3
        }
      },
      "expected_outputs": {
        "min_fiber_count": 50,
        "max_fiber_count": 1000,
        "min_avg_length": 10,
        "max_avg_length": 120
      },
      "matlab_reference_mat": "test_ct_fire_real2_th30.mat"
    },
    {
      "name": "syn1_th98",

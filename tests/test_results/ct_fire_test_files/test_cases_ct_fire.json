    }
  ],
  "tolerances": {
    "fiber_count": {
      "description": "Tolerance for number of fibers detected",
      "relative": 0.15,
      "note": "15% tolerance accounts for differences in edge cases"
    },
    "fiber_length": {
      "description": "Tolerance for average fiber length",
      "relative": 0.10,
      "absolute": 5.0,
      "note": "10% relative or 5 pixels absolute"
    },
    "fiber_angle": {
      "description": "Tolerance for fiber angles",
      "absolute_degrees": 5.0,
      "note": "5 degree tolerance for angle measurements"
    },
    "soft_iou": {
      "description": "Minimum soft IoU for Python vs MATLAB centerline spatial agreement",
      "threshold": 0.80,
      "note": "Higher than fire_2d (0.50) because CT preprocessing should preserve spatial structure"
    }
  },
  "notes": [
    "MATLAB reference files (.mat) must be generated by running ctFIRE in MATLAB",
    "Each .mat file must contain a 'data' structure with Xa, Fa, Ra, M fields",
    "To generate: ctFIREout = ctFIREfun(cP, cP2, im3); save('ref.mat', '-v7.3', 'ctFIREout')",
    "MATLAB Xa uses [col, row, z] convention (opposite to Python [row, col])",
    "coefficient_percentile=0.2 keeps top 80% of curvelet coefficients by energy",
    "num_scales=3 uses the 3 finest scales for reconstruction (matches MATLAB ctFIRE SS=3)"
  ]
}

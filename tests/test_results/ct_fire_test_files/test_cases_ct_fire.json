      "description": "syn2 image (35 synthetic fibers) with thresh_im2=98 heavy background masking, adjusted linking thresholds",
      "ctfire_params": {
        "coefficient_percentile": 0.2,
        "num_scales": 3,
        "LL1": 30,
        "value": {
          "sigma_im": 0,
          "sigma_d": 0.3,
          "dtype": "cityblock",
          "thresh_im": [],

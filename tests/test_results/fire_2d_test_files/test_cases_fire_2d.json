  "tolerances": {
    "fiber_count": {
      "description": "Tolerance for number of fibers detected",
      "relative": 0.15,
      "note": "15% tolerance accounts for differences in edge cases"
    },
    "fiber_length": {
      "description": "Tolerance for average fiber length",
      "relative": 0.10,
      "absolute": 5.0,
      "note": "10% relative or 5 pixels absolute"
    },
    "fiber_angle": {
      "description": "Tolerance for fiber angles",
      "absolute_degrees": 5.0,
      "note": "5 degree tolerance for angle measurements"
    },
    "vertex_position": {
      "description": "Tolerance for vertex coordinates",
      "absolute_pixels": 2.0,
      "note": "2 pixel tolerance for coordinate precision"
    },
    "network_stats": {
      "description": "Tolerance for network statistics",
      "relative": 0.10,
      "note": "10% tolerance for derived statistics"
    }
  },
  "notes": [
    "MATLAB reference files (.mat) should contain 'data' structure from fire_2D_ang1 output",
    "Python implementation currently missing check_danglers and full fiberproc",
    "Expected differences: Python may have 10-30% more fibers, 20% shorter average length",
    "To generate MATLAB reference: run fire_2D_ang1(p, im3, 0) and save('ref.mat', 'data')"
  ]

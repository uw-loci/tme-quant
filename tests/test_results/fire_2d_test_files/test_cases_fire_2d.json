{
  "description": "Test cases for fire_2D_ang1 Python implementation vs MATLAB reference",
  "test_cases": [
    {
      "name": "syn1_20fibers_th98_params",
      "image": "syn1_20fibers.png",
      "description": "Standard syn1 image with  background threshold of 98",
      "params": {
        "sigma_im": 0,
        "sigma_d": 0.3,
        "dtype": "cityblock",
        "thresh_im": [],
        "thresh_im2": 98,
        "thresh_Dxlink": 1.5,
        "s_xlinkbox": 8,
        "thresh_LMP": 0.2,
        "thresh_LMPdist": 2,
        "thresh_ext": 0.342,
        "lam_dirdecay": 0.5,
        "s_minstep": 2,
        "s_maxstep": 6,
        "thresh_dang_aextend": 0.9848,
        "thresh_dang_L": 15,
        "thresh_short_L": 15,
        "s_fiberdir": 4,
        "thresh_linkd": 15,
        "thresh_linka": -0.866,
        "thresh_flen": 15,
        "thresh_numv": 3,
        "scale": [1.0, 1.0, 1.0],
        "s_boundthick": 10,
        "blist": 1,
        "s_maxspace": 5,
        "lambda": 0.01,
        "ang_interval": 3
      },
      "expected_outputs": {
        "min_fiber_count": 50,
        "max_fiber_count": 2000,
        "min_avg_length": 10,
        "max_avg_length": 150,
        "note": "High fiber count expected: Python bypasses check_danglers (see CTFIRE_CONVERSION.md)"
      },
      "matlab_reference_mat": "test_fire_2d_syn1_20fibers_th98.mat"
    },

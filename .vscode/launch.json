{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    },
    {
      "name": "Launch napari (TMEQuant plugin)",
      "type": "debugpy",
      "request": "launch",
      "module": "napari",
      "args": [],
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src/tme_quant/src"
      }
    },
    {
      "name": "Launch napari (TMEQuant plugin, open dock widget)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/tme_quant/napari-tme-quant/scripts/launch_plugin.py",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src/tme_quant/src"
      }
    },
    {
      "name": "Launch napari (TMEQuant + curvelops)",
      "type": "debugpy",
      "request": "launch",
      "module": "napari",
      "args": [],
      "console": "integratedTerminal",
      "justMyCode": false,
      "python": "${workspaceFolder}/src/tme_quant/.venv-curvelops/bin/python.exe",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src/tme_quant/src"
      }
    }
  ]
}